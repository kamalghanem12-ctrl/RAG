# Secrets — never commit (CLAUDE.md §21, Delinea PAM is the source of truth)
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
secrets/
**/secrets*

# Claude Code local-only files.
# Hookify rules are deliberately NOT ignored: they are security controls, not
# personal preference. If only one engineer's machine has them they enforce
# nothing. See .claude/README.md.
.claude/*.local.md
!.claude/hookify.*.local.md
.claude/settings.local.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Local dev
.vscode/
.idea/
*.log
